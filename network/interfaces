# /etc/network/interfaces del host Proxmox
# Sustituye los valores entre [CORCHETES] por los de tu entorno.
#
# nic0 -> adaptador Host-Only de VMware (red interna de VLANs, sin Internet)
# nic1 -> adaptador NAT de VMware (salida a Internet)

auto lo
iface lo inet loopback

auto nic0
iface nic0 inet manual

auto nic1
iface nic1 inet manual

# ---------------------------------------------------------------
# WAN: vmbr0 (salida a Internet con NAT)
# ---------------------------------------------------------------
auto vmbr0
iface vmbr0 inet static
        address [IP_PROXMOX]/24
        gateway [GATEWAY_PROXMOX]
        bridge-ports nic1
        bridge-stp off
        bridge-fd 0
        post-up echo 1 > /proc/sys/net/ipv4/ip_forward
        post-up iptables -t nat -A POSTROUTING -s 10.0.0.0/8 -o vmbr0 -j MASQUERADE

# ---------------------------------------------------------------
# LAN interna: vmbr1 (bridge VLAN-aware)
# Carga las reglas de firewall inter-VLAN al levantar el bridge.
# ---------------------------------------------------------------
auto vmbr1
iface vmbr1 inet manual
        bridge-ports nic0
        bridge-stp off
        bridge-fd 0
        bridge-vlan-aware yes
        post-up /usr/local/sbin/tfc-iptables.sh

# VLAN 10 - Servidor web (Apache + PHP)
auto vmbr1.10
iface vmbr1.10 inet static
        address 10.0.10.1/24

# VLAN 20 - Base de datos (MariaDB)
auto vmbr1.20
iface vmbr1.20 inet static
        address 10.0.20.1/24

# VLAN 30 - Dominio e identidad (Samba4 AD DC)
auto vmbr1.30
iface vmbr1.30 inet static
        address 10.0.30.1/24

# VLAN 40 - Clientes y agentes Telegraf
auto vmbr1.40
iface vmbr1.40 inet static
        address 10.0.40.1/24

source /etc/network/interfaces.d/*
